<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>家計簿ダッシュボード</title>
    <style>
        :root {
            color-scheme: light;
            --panel: rgba(255, 255, 255, 0.84);
            --text: #132238;
            --muted: #667085;
            --accent: #0f4c5c;
            --income: #1d4ed8;
            --expense: #dc2626;
            --shadow: 0 20px 60px rgba(19, 34, 56, 0.12);
            --radius: 24px;
        }

        * { box-sizing: border-box; }

        html, body {
            margin: 0;
        }

        body {
            font-family: "Hiragino Sans", "Yu Gothic", "Noto Sans JP", sans-serif;
            color: var(--text);
            background:
                radial-gradient(circle at top left, rgba(15, 76, 92, 0.18), transparent 30%),
                radial-gradient(circle at top right, rgba(217, 119, 6, 0.14), transparent 26%),
                linear-gradient(180deg, #fbf8f3 0%, #f4efe7 100%);
        }

        /*
          画面サイズ（スマホの縦長〜PCの横長）が変わっても、要素の配置（縦1カラムの並び順）は
          常に同じにしたまま、画面の横幅に合わせて全体を拡大縮小して見やすく表示します。
          スクロールは常にページ全体（ブラウザの縦スクロール）で行い、内部の枠だけが
          スクロールすることはありません。実装は #scaleRoot 下部のスクリプトを参照してください。
        */
        .scale-outer { width: 100%; overflow: hidden; position: relative; }
        .scale-root { width: 420px; transform-origin: top left; }

        .shell {
            padding: 18px 0 32px;
        }

        .hero { margin-bottom: 14px; }
        .grid { display: flex; flex-direction: column; gap: 14px; }
        .pie-compare { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .pie-row { display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center; }
        .stack { display: grid; gap: 12px; }

        .hero-card,
        .panel {
            background: var(--panel);
            backdrop-filter: blur(18px);
            border: 1px solid rgba(255, 255, 255, 0.75);
            box-shadow: var(--shadow);
            border-radius: var(--radius);
        }

        .hero-card { padding: 18px; overflow: hidden; position: relative; }
        .hero-card::after {
            content: "";
            position: absolute;
            inset: auto -8% -24% auto;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(15, 76, 92, 0.22), transparent 68%);
            pointer-events: none;
        }

        .metric, .stat, .entry, .legend-item, .split-row, .weekday, .day, .chart-box {
            border: 1px solid rgba(19, 34, 56, 0.08);
            background: rgba(255, 255, 255, 0.94);
        }

        .eyebrow {
            display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px;
            border-radius: 999px; background: rgba(15, 76, 92, 0.1); color: var(--accent);
            font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
        }

        h1, h2, h3, p { margin: 0; }
        h1 { margin-top: 10px; font-size: 1.7rem; line-height: 1.15; }
        .hero p { margin-top: 8px; color: var(--muted); line-height: 1.6; font-size: 0.92rem; }
        .hero-grid { display: grid; gap: 8px; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 14px; }
        .flow-stats { display: flex; align-items: center; gap: 6px; }
        .flow-stat { flex: 1; min-width: 0; text-align: center; }
        .flow-stat small, .flow-stat strong { display: block; }
        .flow-stat strong { font-size: 0.98rem; word-break: break-all; }
        .flow-stat-result { background: rgba(15, 76, 92, 0.08); }
        .flow-op { flex: 0 0 auto; font-weight: 800; color: var(--muted); font-size: 1.15rem; }
        .stat { border-radius: 14px; padding: 12px; }
        .stat small, .metric .label { display: block; color: var(--muted); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; }
        .stat strong, .metric .value { display: block; margin-top: 6px; font-size: 1.05rem; font-weight: 700; }
        .metric input[type="month"] {
            width: 100%; border: 1px solid rgba(19, 34, 56, 0.14); border-radius: 12px;
            padding: 10px 12px; background: rgba(255, 255, 255, 0.94); color: var(--text); font: inherit; font-weight: 700;
        }

        .panel { padding: 16px; }
        .panel h2 { font-size: 1.02rem; margin-bottom: 10px; }
        .panel h3 { font-size: 0.98rem; margin-bottom: 10px; color: var(--accent); }
        .hint { color: var(--muted); font-size: 0.92rem; line-height: 1.7; margin-bottom: 16px; }
        /* 使い方ガイド オフのときは .guide-text 要素をすべて隠す（設定パネルのトグルで切替） */
        body.guides-off .guide-text { display: none !important; }

        .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
        .field { display: grid; gap: 8px; }
        .field label { font-size: 0.86rem; color: var(--muted); }
        .field input, .field select, .field textarea {
            width: 100%; border: 1px solid rgba(19, 34, 56, 0.14); border-radius: 14px;
            padding: 12px 14px; background: rgba(255, 255, 255, 0.94); color: var(--text); font: inherit;
        }
        .field textarea { min-height: 108px; resize: vertical; }
        .span-2 { grid-column: span 2; }

        .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
        button {
            border: 0; border-radius: 999px; padding: 12px 16px; background: var(--accent);
            color: #fff; font: inherit; font-weight: 700; cursor: pointer;
        }
        button.secondary { background: rgba(15, 76, 92, 0.12); color: var(--accent); }
        button.btn-sm { padding: 8px 14px; font-size: 0.82rem; }
        button.danger { background: rgba(220, 38, 38, 0.12); color: var(--expense); }

        /* 各タブごとの年月ナビ（＜ 月 ＞） */
        .month-nav { display: grid; grid-template-columns: auto 1fr auto; gap: 8px; align-items: center; }
        .month-nav-btn {
            width: 42px; height: 42px; padding: 0; border-radius: 12px; font-size: 1.2rem;
            background: rgba(15, 76, 92, 0.1); color: var(--accent);
        }
        .month-nav input[type="month"] {
            text-align: center; font-size: 1.05rem; font-weight: 800; padding: 10px 6px;
        }
        .month-picker-bar { display: flex; flex-direction: column; gap: 8px; margin-bottom: 14px; }
        .month-picker-bar .month-nav { width: 100%; }
        .month-picker-bar .muted { font-size: 0.82rem; }

        /* カテゴリー管理（カテゴリー欄の下にインライン表示） */
        .category-inline-manager {
            margin-top: 10px; padding: 12px; border: 1px dashed rgba(15, 76, 92, 0.3);
            background: rgba(15, 76, 92, 0.04); border-radius: 14px;
        }
        .category-manager { display: grid; gap: 8px; }
        .category-manage-row { display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: center; }
        .category-manage-row input[type="text"] {
            border: 1px solid rgba(19, 34, 56, 0.14); border-radius: 10px; padding: 8px 10px;
            font: inherit; background: rgba(255, 255, 255, 0.94); color: var(--text);
        }

        /* タブ切り替え（収支記録 / 分析 / 割り勘 / 貯蓄管理） */
        .tabs { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
        .tab-btn {
            background: rgba(255, 255, 255, 0.7); color: var(--muted); border: 1px solid rgba(19, 34, 56, 0.1);
            padding: 12px 22px; border-radius: 999px; font-weight: 700; cursor: pointer;
        }
        .tab-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }
        .tab-panel { display: none; }
        .tab-panel.active { display: block; }

        /* 支出・収入 ワンタッチ切り替え */
        .kind-toggle { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        .kind-btn {
            background: rgba(19, 34, 56, 0.06); color: var(--muted); border: 1px solid transparent; border-radius: 14px;
            padding: 12px; font-weight: 700;
        }
        .kind-btn[data-kind="EXPENSE"].active { background: rgba(220, 38, 38, 0.12); color: var(--expense); border-color: rgba(220, 38, 38, 0.3); }
        .kind-btn[data-kind="INCOME"].active { background: rgba(29, 78, 216, 0.12); color: var(--income); border-color: rgba(29, 78, 216, 0.3); }

        .list, .legend, .split-list, .participants { display: grid; gap: 8px; }
        .entry, .legend-item, .split-row { padding: 10px 12px; border-radius: 16px; }
        .entry-top { display: flex; justify-content: space-between; gap: 12px; align-items: center; }
        .entry-actions { display: flex; gap: 8px; margin-top: 8px; }
        .category-label { font-size: 0.92rem; font-weight: 700; color: var(--text); }
        .memo-label { font-size: 0.76rem; color: var(--muted); margin-top: 2px; }
        .badge { display: inline-flex; align-items: center; gap: 8px; padding: 6px 10px; border-radius: 999px; background: rgba(15, 76, 92, 0.1); color: var(--accent); font-size: 12px; font-weight: 700; }
        .legend-item { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 0.82rem; }
        .legend-item strong { font-size: 0.82rem; font-weight: 700; }
        .amount { font-size: 0.92rem; }
        .amount.income { color: var(--income); font-weight: 800; }
        .amount.expense { color: var(--expense); font-weight: 800; }
        .muted { color: var(--muted); font-size: 0.82rem; }

        .chart-box { border-radius: 20px; padding: 14px; position: relative; }
        .chart-tooltip {
            position: absolute; transform: translate(-50%, calc(-100% - 10px));
            background: rgba(19, 34, 56, 0.92); color: #fff; padding: 6px 12px; border-radius: 10px;
            font-size: 12px; font-weight: 700; white-space: nowrap; pointer-events: none; z-index: 5;
        }
        .chart-tooltip::after {
            content: ""; position: absolute; left: 50%; top: 100%; transform: translateX(-50%);
            border: 6px solid transparent; border-top-color: rgba(19, 34, 56, 0.92);
        }
        canvas { width: 100%; height: 240px; display: block; }
        .chart-box-large canvas { height: 190px; }
        .pie { width: 148px; aspect-ratio: 1; border-radius: 50%; background: conic-gradient(#cbd5e1 0deg 360deg); position: relative; }
        .pie::after { content: ""; position: absolute; inset: 20px; border-radius: 50%; background: #fff; }

        .calendar { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; }
        .calendar-large { gap: 5px; }
        .calendar-large .day, .calendar-large .weekday { min-height: 46px; }
        .weekday, .day {
            min-height: 42px; padding: 4px 3px; border-radius: 10px;
            overflow: hidden; /* 万一はみ出しても枠の外には出さない */
        }
        .weekday { min-height: auto; text-align: center; font-size: 10px; font-weight: 700; color: var(--muted); }
        .day .date { display: flex; justify-content: space-between; font-size: 10px; margin-bottom: 4px; }
        .day .income-day,
        .day .expense-day {
            font-weight: 700; font-size: 10px; line-height: 1.35;
            white-space: nowrap; overflow: hidden; max-width: 100%;
        }
        .day .income-day { color: var(--income); }
        .day .expense-day { color: var(--expense); }
        .day.saturday { background: rgba(14, 165, 233, 0.1); }
        .day.sunday, .day.holiday { background: rgba(220, 38, 38, 0.1); }
        .day.empty { background: transparent; border: 1px dashed rgba(19, 34, 56, 0.12); }
        .day:not(.empty) { cursor: pointer; transition: transform 0.12s ease, box-shadow 0.12s ease; }
        .day:not(.empty):hover { transform: translateY(-2px); box-shadow: 0 8px 18px rgba(19, 34, 56, 0.12); }
        .day.selected { outline: 2px solid var(--accent); outline-offset: -2px; }
        .day-detail { border-top: 1px dashed rgba(19, 34, 56, 0.14); padding-top: 16px; }

        /* 参加者・支払い明細（割り勘） */
        .participant-row { display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: center; }
        .payment-editor { padding: 16px; border: 1px dashed rgba(15, 76, 92, 0.3); background: rgba(15, 76, 92, 0.04); border-radius: 16px; }
        .payments-list .split-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
        .covered-checkboxes { display: flex; flex-wrap: wrap; gap: 10px 16px; }
        .covered-item {
            display: inline-flex; align-items: center; gap: 6px; font-size: 0.9rem; color: var(--text); line-height: 1.1;
        }
        .covered-item input[type="checkbox"] {
            margin: 0; width: 16px; height: 16px; flex-shrink: 0; accent-color: var(--accent);
        }
        .remove-btn {
            width: 32px; height: 32px; padding: 0; border-radius: 50%;
            background: rgba(220, 38, 38, 0.1); color: var(--expense); font-weight: 800; line-height: 1;
            display: inline-flex; align-items: center; justify-content: center; font-size: 16px;
        }

        /* 貯蓄管理タブ */
        .progress-bar { width: 100%; height: 14px; border-radius: 999px; background: rgba(19, 34, 56, 0.08); overflow: hidden; }
        .progress-bar-fill { height: 100%; background: linear-gradient(90deg, #0f4c5c, #1d4ed8); border-radius: 999px; transition: width 0.3s ease; }

        /* 配置は常に同じ縦1カラムのまま、#scaleRoot に対する transform: scale() で
           画面幅に合わせて全体を拡大縮小します（詳細はページ末尾のスクリプト）。 */

        /* ---------- ハンバーガーメニュー・設定パネル ---------- */
        .topbar { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
        .hamburger-btn {
            width: 44px; height: 44px; border-radius: 14px; padding: 0; background: rgba(255,255,255,0.85);
            border: 1px solid rgba(19,34,56,0.12); color: var(--accent); font-size: 18px;
            display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 4px;
        }
        .hamburger-btn span { display: block; width: 20px; height: 2px; background: var(--accent); border-radius: 2px; }
        .topbar .app-title { font-weight: 800; font-size: 1.05rem; color: var(--accent); }
        .topbar .current-user { margin-left: auto; color: var(--muted); font-size: 0.88rem; }

        .settings-backdrop {
            position: fixed; inset: 0; background: rgba(19,34,56,0.35); z-index: 40;
            opacity: 0; pointer-events: none; transition: opacity 0.15s ease;
        }
        .settings-backdrop.open { opacity: 1; pointer-events: auto; }

        .settings-panel {
            position: fixed; top: 0; left: 0; height: 100vh; width: min(360px, 92vw);
            background: #fff; box-shadow: 0 0 40px rgba(19,34,56,0.25); z-index: 41;
            transform: translateX(-100%); transition: transform 0.18s ease;
            padding: 22px 22px 64px; overflow-y: auto; -webkit-overflow-scrolling: touch;
            overscroll-behavior: contain; display: flex; flex-direction: column; gap: 22px;
        }
        .settings-panel.open { transform: translateX(0); }
        .settings-panel h2 { font-size: 1.2rem; }
        .settings-close { align-self: flex-end; background: rgba(19,34,56,0.06); color: var(--muted); width: 32px; height: 32px; border-radius: 50%; padding: 0; }
        .settings-section { border-top: 1px dashed rgba(19,34,56,0.12); padding-top: 16px; }
        .settings-section:first-of-type { border-top: 0; padding-top: 0; }
        .settings-section h3 { margin-bottom: 8px; }
        .settings-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 10px; }
        .switch { position: relative; width: 44px; height: 26px; flex: 0 0 auto; }
        .switch input { opacity: 0; width: 0; height: 0; }
        .switch .track { position: absolute; inset: 0; background: rgba(19,34,56,0.18); border-radius: 999px; cursor: pointer; transition: background 0.15s ease; }
        .switch .track::after { content: ""; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; background: #fff; border-radius: 50%; transition: transform 0.15s ease; }
        .switch input:checked + .track { background: var(--accent); }
        .switch input:checked + .track::after { transform: translateX(18px); }
        .device-item { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 10px; border-radius: 12px; background: rgba(19,34,56,0.04); margin-bottom: 8px; font-size: 0.86rem; }
        .settings-note { color: var(--muted); font-size: 0.82rem; line-height: 1.6; }
    </style>
</head>
<body>
    <div class="settings-backdrop" id="settingsBackdrop"></div>
    <aside class="settings-panel" id="settingsPanel">
        <button type="button" class="settings-close" id="settingsCloseBtn">×</button>
        <h2>設定</h2>

        <div class="settings-section">
            <h3>アカウント</h3>
            <p class="muted">ログイン中のメールアドレス：<%= initialData.user.email %></p>
            <div class="field" style="margin-top: 8px;">
                <label for="settingsUsernameInput">ユーザー名</label>
                <input type="text" id="settingsUsernameInput" value="<%= initialData.user.username %>">
            </div>
            <div class="actions">
                <button type="button" class="secondary btn-sm" id="saveUsernameBtn">ユーザー名を変更</button>
            </div>
            <div class="actions" style="margin-top: 10px;">
                <button type="button" class="secondary btn-sm" id="logoutBtn">ログアウト</button>
            </div>
        </div>

        <div class="settings-section">
            <h3>使い方ガイド</h3>
            <div class="settings-row">
                <span>説明文を表示する</span>
                <label class="switch">
                    <input type="checkbox" id="guidesEnabledToggle" <%= initialData.user.guidesEnabled ? "checked" : "" %>>
                    <span class="track"></span>
                </label>
            </div>
            <p class="settings-note">オフにすると、画面内の使い方の説明文を非表示にします。</p>
        </div>

        <div class="settings-section">
            <h3>Face ID・指紋でログイン</h3>
            <p class="settings-note">この端末でWebAuthn（Face ID・指紋・画面ロック等）を使ったログインを許可します。</p>
            <div id="webauthnDeviceList"></div>
            <div class="actions">
                <button type="button" class="secondary btn-sm" id="registerBiometricBtn">この端末を登録する</button>
            </div>
        </div>

        <div class="settings-section">
            <h3>退会</h3>
            <p class="settings-note">退会すると、記録・カテゴリー・サブスク・予算などすべてのデータが削除され、元に戻せません。</p>
            <div class="actions">
                <button type="button" class="danger btn-sm" id="deleteAccountBtn">アカウントを退会する</button>
            </div>
        </div>
    </aside>

    <div class="scale-outer" id="scaleOuter">
    <div class="scale-root" id="scaleRoot">
    <div class="shell">
        <div class="topbar">
            <button type="button" class="hamburger-btn" id="openSettingsBtn" title="設定" aria-label="設定を開く">
                <span></span><span></span><span></span>
            </button>
            <div class="app-title">MoneyPilot</div>
            <div class="current-user"><%= initialData.user.username %> さん</div>
        </div>

        <section class="hero">
            <div class="hero-card">
                <h1>MoneyPilot</h1>
                <p>家計管理・収支分析・割り勘計算・貯蓄管理をひとつのアプリで。</p>
                <p>日々の支出・収入を記録し、月ごとの分析やカレンダー表示でお金の流れを可視化します。</p>

                <p class="hint guide-text" style="margin-top: 14px;">棒をタップ／クリックすると金額が表示されます。</p>
                <div class="chart-box chart-box-large">
                    <canvas id="monthlyChart"></canvas>
                    <div class="chart-tooltip" id="chartTooltip" style="display: none;"></div>
                </div>
                <div class="muted" id="monthlyChartLabel"></div>
            </div>

        </section>

        <div class="tabs" role="tablist">
            <button type="button" class="tab-btn active" data-tab="tab-record">収支記録</button>
            <button type="button" class="tab-btn" data-tab="tab-analysis">分析</button>
            <button type="button" class="tab-btn" data-tab="tab-split">割り勘</button>
            <button type="button" class="tab-btn" data-tab="tab-savings">貯蓄管理</button>
        </div>

        <div class="tab-content-area">
        <div id="tab-record" class="tab-panel active">
            <div class="grid">
                <div class="stack">
                    <section class="panel">
                        <h2>支出・収入の記録</h2>

                        <form id="transactionForm">
                            <div class="field span-2" style="margin-bottom: 14px;">
                                <div class="kind-toggle">
                                    <button type="button" class="kind-btn active" data-kind="EXPENSE">支出</button>
                                    <button type="button" class="kind-btn" data-kind="INCOME">収入</button>
                                </div>
                                <input type="hidden" id="kind" name="kind" value="EXPENSE">
                            </div>

                            <div class="form-grid">
                                <div class="field">
                                    <label for="amount">金額</label>
                                    <input id="amount" name="amount" type="number" min="0" placeholder="0" required>
                                </div>
                                <div class="field">
                                    <label for="occurredAt">日付</label>
                                    <input id="occurredAt" name="occurredAt" type="date" required>
                                </div>
                                <div class="field">
                                    <label for="category">カテゴリー</label>
                                    <select id="category" name="category" required></select>

                                    <div class="category-inline-manager" id="categoryInlineManager" style="display: none;">
                                        <div class="category-manager" id="categoryManagerList"></div>
                                        <div class="category-manage-row" style="margin-top: 8px;">
                                            <input type="text" id="newCategoryInput" placeholder="新しいカテゴリー名">
                                            <button type="button" class="secondary btn-sm" id="addCategoryBtn">追加</button>
                                        </div>
                                        <div class="actions" style="margin-top: 10px;">
                                            <button type="button" class="secondary btn-sm" id="closeCategoryManager">完了して選択に戻る</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="field">
                                    <label for="paymentMethod">支払い方法</label>
                                    <select id="paymentMethod" name="paymentMethod" required></select>

                                    <div class="category-inline-manager" id="paymentMethodInlineManager" style="display: none;">
                                        <div class="category-manager" id="paymentMethodManagerList"></div>
                                        <div class="category-manage-row" style="margin-top: 8px;">
                                            <input type="text" id="newPaymentMethodInput" placeholder="新しい支払い方法">
                                            <button type="button" class="secondary btn-sm" id="addPaymentMethodBtn">追加</button>
                                        </div>
