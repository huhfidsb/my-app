        // --- 割り勘：参加者の追加・削除（×） ---
        function getParticipantNames() {
            return [...elements.participants.querySelectorAll(".participant-name")]
                .map((input) => input.value.trim())
                .filter((name) => name.length > 0);
        }

        function createParticipantRow(name = "") {
            const row = document.createElement("div");
            row.className = "participant-row";
            row.innerHTML = `
                <input type="text" class="participant-name" placeholder="参加者名" value="${escapeHtml(name)}">
                <button type="button" class="remove-btn" title="この参加者を削除">×</button>
            `;
            row.querySelector(".remove-btn").addEventListener("click", () => {
                row.remove();
                syncPaymentEditorOptions();
            });
            row.querySelector(".participant-name").addEventListener("change", syncPaymentEditorOptions);
            return row;
        }

        // --- 割り勘：支払い明細の入力エリア（誰が payer / 誰の分か coveredBy）---
        function currentCoveredSelection() {
            return [...document.getElementById("paymentCoveredInput").querySelectorAll("input:checked")].map((box) => box.value);
        }

        function syncPaymentEditorCheckboxes(selectedNames) {
            const names = getParticipantNames();
            const container = document.getElementById("paymentCoveredInput");
            const shouldCheckAll = selectedNames.length === 0;
            container.innerHTML = names.map((name) => `
                <label class="covered-item">
                    <input type="checkbox" value="${escapeHtml(name)}" ${shouldCheckAll || selectedNames.includes(name) ? "checked" : ""}>
                    ${escapeHtml(name)}
                </label>
            `).join("");
        }

        function syncPaymentEditorOptions() {
            const names = getParticipantNames();
            const select = document.getElementById("paymentPayerInput");
            const previousPayer = select.value;
            select.innerHTML = `<option value="">選択してください</option>` + names.map((name) => `<option value="${escapeHtml(name)}">${escapeHtml(name)}</option>`).join("");
            if (names.includes(previousPayer)) {
                select.value = previousPayer;
            }
            syncPaymentEditorCheckboxes(currentCoveredSelection());
        }

        function resetPaymentEditor() {
            const editor = document.getElementById("paymentEditor");
            editor.dataset.editingIndex = "";
            document.getElementById("paymentPayerInput").value = "";
            document.getElementById("paymentAmountInput").value = "";
            syncPaymentEditorCheckboxes([]);
            document.getElementById("commitPayment").textContent = "この内容を追加する";
            document.getElementById("cancelPaymentEdit").style.display = "none";
        }

        function renderPaymentsList() {
            const container = elements.paymentsList;
            if (!splitPayments.length) {
                container.innerHTML = '<div class="entry"><p class="muted">まだ支払い明細がありません。下のフォームから追加してください。</p></div>';
                return;
            }
            const participants = getParticipantNames();
            container.innerHTML = splitPayments.map((payment, index) => {
                const coveredNames = payment.coveredBy && payment.coveredBy.length ? payment.coveredBy : participants;
                return `
                    <div class="split-row">
                        <span>${escapeHtml(payment.payer)} が支払い（対象: ${coveredNames.map(escapeHtml).join("・") || "全員"}）</span>
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <strong>${formatAmount(payment.amount)}</strong>
                            <button type="button" class="secondary btn-sm edit-payment" data-index="${index}">編集</button>
                            <button type="button" class="danger btn-sm delete-payment" data-index="${index}">削除</button>
                        </div>
                    </div>
                `;
            }).join("");
        }

        document.getElementById("commitPayment").addEventListener("click", () => {
            const payer = document.getElementById("paymentPayerInput").value;
            const amount = Number(document.getElementById("paymentAmountInput").value);
            const coveredBy = currentCoveredSelection();

            if (!payer) {
                alert("支払った人を選択してください。");
                return;
            }
            if (!amount || amount <= 0) {
                alert("金額を入力してください。");
                return;
            }

            const editor = document.getElementById("paymentEditor");
            const editingIndex = editor.dataset.editingIndex;
            const paymentEntry = { payer, amount, coveredBy };

            if (editingIndex !== undefined && editingIndex !== "") {
                splitPayments[Number(editingIndex)] = paymentEntry;
            } else {
                splitPayments.push(paymentEntry);
            }

            resetPaymentEditor();
            renderPaymentsList();
        });

        document.getElementById("cancelPaymentEdit").addEventListener("click", resetPaymentEditor);

        elements.paymentsList.addEventListener("click", (event) => {
