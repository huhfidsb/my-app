            </div>
        </div>
        </div>
    </div>

    <script id="initial-data" type="application/json"><%- JSON.stringify(initialData).replace(/</g, "\\u003c") %></script>

    <script>
        const initialData = JSON.parse(document.getElementById("initial-data").textContent || "{}");
        const currencyFormatter = new Intl.NumberFormat("ja-JP");
        const weekdayLabels = ["日", "月", "火", "水", "木", "金", "土"];
        let latestMonthlyGraph = initialData.yearlyGraph;
        let latestTransactions = [];
        let latestSplitSessions = [];
        let latestAnalysisTransactions = initialData.monthSummary.transactions || [];
        let selectedDayKey = null;
        let splitPayments = [];

        const elements = {
            transactionList: document.getElementById("transactionList"),
            monthlyChart: document.getElementById("monthlyChart"),
            monthlyChartLabel: document.getElementById("monthlyChartLabel"),
            chartTooltip: document.getElementById("chartTooltip"),
            expenseCategoryPie: document.getElementById("expenseCategoryPie"),
            expenseCategoryLegend: document.getElementById("expenseCategoryLegend"),
            incomeCategoryPie: document.getElementById("incomeCategoryPie"),
            incomeCategoryLegend: document.getElementById("incomeCategoryLegend"),
            calendar: document.getElementById("calendar"),
            splitResult: document.getElementById("splitResult"),
            participants: document.getElementById("participants"),
            paymentsList: document.getElementById("paymentsList"),
            categoryManagerList: document.getElementById("categoryManagerList"),
            categoryInlineManager: document.getElementById("categoryInlineManager"),
            categorySelect: document.getElementById("category"),
            transactionForm: document.getElementById("transactionForm"),
            splitForm: document.getElementById("splitForm"),
            recordMonth: document.getElementById("recordMonth"),
            analysisMonth: document.getElementById("analysisMonth"),
            splitMonth: document.getElementById("splitMonth"),
            savingsMonth: document.getElementById("savingsMonth"),
        };

        let categories = initialData.categories || [];

        function api(path, options = {}) {
            return fetch(path, {
                headers: { "Content-Type": "application/json", ...(options.headers || {}) },
                ...options,
            }).then(async (response) => {
                const data = await response.json().catch(() => ({}));
                if (!response.ok) throw new Error(data.message || "API request failed");
                return data;
            });
        }

        function formatAmount(value) { return `${currencyFormatter.format(value)}円`; }

        function escapeHtml(value) {
            return String(value ?? "").replace(/[&<>"']/g, (char) => ({
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                '"': "&quot;",
                "'": "&#39;",
            }[char]));
        }

        // --- タブ切り替え（収支記録 / 分析 / 割り勘 / 貯蓄管理） ---
        document.querySelectorAll(".tab-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                document.querySelectorAll(".tab-btn").forEach((b) => b.classList.remove("active"));
                document.querySelectorAll(".tab-panel").forEach((panel) => panel.classList.remove("active"));
                btn.classList.add("active");
                document.getElementById(btn.dataset.tab).classList.add("active");

                // canvasは非表示(display:none)の間は幅0で描画されてしまうため、
                // 分析タブが表示された直後に描き直す
                if (btn.dataset.tab === "tab-analysis") {
                    renderMonthlyChart(latestMonthlyGraph);
                }
            });
        });

        // --- 支出・収入 ワンタッチ切り替え ---
        document.querySelectorAll(".kind-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                document.querySelectorAll(".kind-btn").forEach((b) => b.classList.remove("active"));
                btn.classList.add("active");
                document.getElementById("kind").value = btn.dataset.kind;
            });
        });

        // --- カテゴリー管理（DBに保存されるので、リロードしても内容が保持される） ---
        // プルダウンの一番下にある「（追加・編集）」を選ぶと、インラインの管理パネルが開く。
        const MANAGE_CATEGORY_VALUE = "__manage_categories__";
        let lastCategoryValue = "";

        function renderCategoryManagerList() {
            elements.categoryManagerList.innerHTML = categories.length
                ? categories.map((category) => `
                    <div class="category-manage-row">
                        <input type="text" class="category-manage-input" value="${escapeHtml(category.name)}" data-id="${category.id}">
                        <button type="button" class="remove-btn category-manage-delete" data-id="${category.id}" title="このカテゴリーを削除">×</button>
                    </div>
                `).join("")
                : '<span class="muted">カテゴリーがまだありません。下の欄から追加してください。</span>';
        }

        function populateCategorySelect(preferredValue) {
            const select = elements.categorySelect;
            const previous = preferredValue !== undefined ? preferredValue : select.value;
            const names = categories.map((category) => category.name);
            const options = previous && !names.includes(previous) && previous !== MANAGE_CATEGORY_VALUE ? [...names, previous] : names;
            select.innerHTML = options.map((name) => `<option value="${escapeHtml(name)}">${escapeHtml(name)}</option>`).join("")
                + `<option value="${MANAGE_CATEGORY_VALUE}">（追加・編集）</option>`;
            if (previous && options.includes(previous)) {
                select.value = previous;
                lastCategoryValue = previous;
            } else if (names.length) {
                lastCategoryValue = select.value;
            }
        }

        async function loadCategories(preferredValue) {
            const data = await api("/api/categories");
            categories = data.items;
            renderCategoryManagerList();
            populateCategorySelect(preferredValue);
        }

        function openCategoryManager() {
            elements.categoryInlineManager.style.display = "block";
            elements.categorySelect.style.display = "none";
            renderCategoryManagerList();
        }

        function closeCategoryManager() {
            elements.categoryInlineManager.style.display = "none";
            elements.categorySelect.style.display = "";
            populateCategorySelect(lastCategoryValue);
        }

        elements.categorySelect.addEventListener("change", () => {
            if (elements.categorySelect.value === MANAGE_CATEGORY_VALUE) {
                openCategoryManager();
            } else {
                lastCategoryValue = elements.categorySelect.value;
            }
        });

        elements.categoryManagerList.addEventListener("change", async (event) => {
            if (!event.target.classList.contains("category-manage-input")) return;
            const id = event.target.dataset.id;
            const name = event.target.value.trim();
            if (!name) {
                alert("カテゴリー名を入力してください。");
                await loadCategories();
                renderCategoryManagerList();
                return;
            }
            await api(`/api/categories/${id}`, { method: "PUT", body: JSON.stringify({ name }) });
            await loadCategories();
            renderCategoryManagerList();
        });

        elements.categoryManagerList.addEventListener("click", async (event) => {
            const deleteBtn = event.target.closest(".category-manage-delete");
            if (!deleteBtn) return;
            if (confirm("本当にこのカテゴリーを削除しますか？（過去の記録のカテゴリー名はそのまま残ります）")) {
                await api(`/api/categories/${deleteBtn.dataset.id}`, { method: "DELETE" });
                await loadCategories();
                renderCategoryManagerList();
            }
        });

        document.getElementById("addCategoryBtn").addEventListener("click", async () => {
            const input = document.getElementById("newCategoryInput");
            const name = input.value.trim();
            if (!name) return;
            await api("/api/categories", { method: "POST", body: JSON.stringify({ name }) });
            input.value = "";
            lastCategoryValue = name;
            await loadCategories(name);
            renderCategoryManagerList();
        });

        document.getElementById("closeCategoryManager").addEventListener("click", closeCategoryManager);

        // --- ＜ 月 ＞ ワンタッチ月切り替え（タブごとに独立）---
        function shiftMonthKey(monthKey, delta) {
            const [yearText = "1970", monthText = "01"] = monthKey.split("-");
            const date = new Date(Date.UTC(Number(yearText), Number(monthText) - 1 + delta, 1));
            return `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, "0")}`;
        }

        function wireMonthNav(inputEl, prevBtnId, nextBtnId, onChange) {
            document.getElementById(prevBtnId).addEventListener("click", () => {
                inputEl.value = shiftMonthKey(inputEl.value || initialData.monthKey, -1);
                onChange();
            });
            document.getElementById(nextBtnId).addEventListener("click", () => {
                inputEl.value = shiftMonthKey(inputEl.value || initialData.monthKey, 1);
                onChange();
            });
            inputEl.addEventListener("change", onChange);
        }

        function nthWeekdayOfMonth(year, monthIndex, weekday, occurrence) {
            const firstDay = new Date(year, monthIndex, 1).getDay();
            const offset = (weekday - firstDay + 7) % 7;
            return 1 + offset + (occurrence - 1) * 7;
        }

        function vernalEquinoxDay(year) {
            return Math.floor(20.8431 + 0.242194 * (year - 1980) - Math.floor((year - 1980) / 4));
        }

        function autumnalEquinoxDay(year) {
            return Math.floor(23.2488 + 0.242194 * (year - 1980) - Math.floor((year - 1980) / 4));
        }

        function buildHolidaySet(monthKey) {
            const [yearText = "1970", monthText = "01"] = monthKey.split("-");
            const year = Number(yearText);
            const monthIndex = Number(monthText) - 1;
            const dates = new Set();
            const push = (day) => dates.add(`${monthKey}-${String(day).padStart(2, "0")}`);

            const fixedHolidays = [
                [0, 1],
                [1, 11],
                [1, 23],
                [3, 29],
                [4, 3],
                [4, 4],
                [4, 5],
                [7, 11],
                [10, 3],
                [10, 23],
            ];

            fixedHolidays.forEach(([holidayMonth, day]) => {
                if (holidayMonth === monthIndex) {
                    push(day);
                }
            });

            if (monthIndex === 0) push(nthWeekdayOfMonth(year, 0, 1, 2));
            if (monthIndex === 6) push(nthWeekdayOfMonth(year, 6, 1, 3));
            if (monthIndex === 8) push(nthWeekdayOfMonth(year, 8, 1, 3));
            if (monthIndex === 9) push(nthWeekdayOfMonth(year, 9, 1, 2));
            if (monthIndex === 2) push(vernalEquinoxDay(year));
            if (monthIndex === 8) push(autumnalEquinoxDay(year));

            const allDates = Array.from(dates);
            allDates.forEach((dateKey) => {
                const date = new Date(`${dateKey}T00:00:00`);
                if (date.getDay() === 0) {
                    const substitute = new Date(date);
                    substitute.setDate(substitute.getDate() + 1);
                    const substituteKey = `${substitute.getFullYear()}-${String(substitute.getMonth() + 1).padStart(2, "0")}-${String(substitute.getDate()).padStart(2, "0")}`;
                    dates.add(substituteKey);
                }
            });

            return dates;
        }

        function renderTransactions(items) {
            latestTransactions = items;
            elements.transactionList.innerHTML = items.length
                ? items.map((item) => `
                    <article class="entry">
                        <div class="entry-top">
                            <div>
                                <div class="category-label">${escapeHtml(item.category)}</div>
                                ${item.memo ? `<div class="memo-label">${escapeHtml(item.memo)}</div>` : ""}
                            </div>
