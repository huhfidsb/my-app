                document.getElementById("paymentPayerInput").value = payment.payer;
                document.getElementById("paymentAmountInput").value = payment.amount;
                syncPaymentEditorCheckboxes(payment.coveredBy || []);
                const editor = document.getElementById("paymentEditor");
                editor.dataset.editingIndex = String(index);
                document.getElementById("commitPayment").textContent = "この内容で更新する";
                document.getElementById("cancelPaymentEdit").style.display = "inline-flex";
            }

