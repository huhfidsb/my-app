        function renderCategoryPie(items, pieEl, legendEl, emptyLabel) {
            if (!items.length) {
                pieEl.style.background = "conic-gradient(#cbd5e1 0deg 360deg)";
                legendEl.innerHTML = `<div class="legend-item"><span>${emptyLabel}</span><strong>0円</strong></div>`;
                return;
            }
            const palette = ["#0f4c5c", "#1d4ed8", "#d97706", "#dc2626", "#16a34a", "#7c3aed"];
            let currentAngle = 0;
            const segments = [];
            items.forEach((item, index) => {
                const angle = Math.max(0.5, item.share) / 100 * 360;
                segments.push(`${palette[index % palette.length]} ${currentAngle}deg ${currentAngle + angle}deg`);
                currentAngle += angle;
            });
            pieEl.style.background = `conic-gradient(${segments.join(", ")})`;
            legendEl.innerHTML = items.map((item, index) => `
                <div class="legend-item">
                    <span><span style="display:inline-block;width:10px;height:10px;border-radius:999px;background:${palette[index % palette.length]};margin-right:8px;"></span>${escapeHtml(item.category)}</span>
                    <strong>${formatAmount(item.amount)} / ${item.share}%</strong>
                </div>
            `).join("");
        }

        function renderCalendar(rows) {
            const holidaySet = buildHolidaySet(rows[0]?.dateKey?.slice(0, 7) || initialData.monthKey);
            const weekdayHeader = weekdayLabels.map((label) => `<div class="weekday">${label}</div>`).join("");
            const firstDay = rows[0]?.weekday ?? 0;
            const leadingEmpty = Array.from({ length: firstDay }, () => '<div class="day empty"></div>').join("");
            const days = rows.map((row) => {
                const classes = ["day"];
                if (row.weekday === 0) classes.push("sunday");
                if (row.weekday === 6) classes.push("saturday");
                if (holidaySet.has(row.dateKey)) classes.push("holiday");
                if (row.dateKey === selectedDayKey) classes.push("selected");
                return `
                    <div class="${classes.join(" ")}" data-date="${row.dateKey}">
                        <div class="date"><span>${row.day}</span><span>${weekdayLabels[row.weekday]}</span></div>
                        <div class="income-day">+${row.income ? currencyFormatter.format(row.income) : 0}</div>
                        <div class="expense-day">-${row.expense ? currencyFormatter.format(row.expense) : 0}</div>
                    </div>
                `;
            }).join("");
            elements.calendar.innerHTML = `${weekdayHeader}${leadingEmpty}${days}`;

            if (selectedDayKey && rows.some((row) => row.dateKey === selectedDayKey)) {
                renderDayDetail(selectedDayKey);
