                            </div>
                        </div>

                        <div class="entry-actions">
                            <button type="button" class="secondary btn-sm edit-split" data-id="${session.id}">編集</button>
                            <button type="button" class="danger btn-sm delete-split" data-id="${session.id}">削除</button>
