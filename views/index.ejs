                                    </select>
                                </div>
                                <div class="field">
                                    <label for="satisfaction">満足度</label>
                                    <select id="satisfaction" name="satisfaction">
                                        <% enums.satisfactionLevels.forEach((level) => { %><option value="<%= level %>"><%= level %></option><% }) %>
                                    </select>
                                </div>
                                <div class="field">
                                    <label for="spendingStyle">投資・消費・浪費</label>
                                    <select id="spendingStyle" name="spendingStyle">
                                        <% enums.spendingStyles.forEach((style) => { %><option value="<%= style %>"><%= style %></option><% }) %>
                                    </select>
                                </div>
                                <div class="field span-2">
                                    <label for="memo">メモ</label>
                                    <textarea id="memo" name="memo" placeholder="用途、購入理由、分類メモ"></textarea>
                                </div>
                            </div>

                            <div class="actions">
                                <button type="submit" id="transactionSubmitBtn">保存する</button>
                                <button type="button" class="secondary" id="cancelEditTransaction" style="display: none;">編集をキャンセル</button>
                            </div>
                        </form>
                    </section>
                </div>

                <div class="stack">
                    <section class="panel">
                        <h2>記録一覧</h2>
                        <p class="hint">このタブだけの年月選択です。他のタブの年月とは連動しません。各記録の「編集」を押すとフォームに内容が読み込まれ、更新できます。</p>

                        <div class="month-picker-bar">
                            <div class="month-nav">
                                <button type="button" class="month-nav-btn secondary" id="recordPrevMonth" title="前の月へ">＜</button>
                                <input type="month" id="recordMonth" value="<%= initialData.monthKey %>">
                                <button type="button" class="month-nav-btn secondary" id="recordNextMonth" title="次の月へ">＞</button>
