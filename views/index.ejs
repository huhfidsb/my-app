        function renderBudgetInsights(data) {
            const panel = document.getElementById("budgetInsightsPanel");
            const previousEl = document.getElementById("budgetPreviousResult");
            const currentEl = document.getElementById("budgetCurrentRemaining");

            const hasPrevious = !!data.previousResult;
            const hasCurrent = !!data.currentRemaining;
            panel.style.display = hasPrevious || hasCurrent ? "block" : "none";

            if (hasPrevious) {
                const diff = data.previousResult.diff;
                previousEl.style.display = "block";
                previousEl.innerHTML = diff >= 0
                    ? `<small>先月の予算の結果</small><strong style="color: var(--income);">先月は${formatAmount(diff)}貯蓄できました！</strong>`
                    : `<small>先月の予算の結果</small><strong style="color: var(--expense);">${formatAmount(Math.abs(diff))}足りませんでした</strong>`;
            } else {
                previousEl.style.display = "none";
            }

            if (hasCurrent) {
                currentEl.style.display = "block";
                document.getElementById("budgetDaysRemaining").textContent = `今月の残り予算（残り${data.currentRemaining.daysRemaining}日）`;
                document.getElementById("budgetRemainingList").innerHTML = data.currentRemaining.categories.map((c) => `
                    <div class="entry">
                        <div class="entry-top">
                            <span class="category-label">${escapeHtml(c.category)}</span>
                            <span class="amount ${c.remaining >= 0 ? "income" : "expense"}">残り${formatAmount(c.remaining)}</span>
                        </div>
                    </div>
                `).join("");
            } else {
                currentEl.style.display = "none";
            }
        }

