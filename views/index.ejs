        let chartBarRects = [];

        function renderMonthlyChart(graph) {
            latestMonthlyGraph = graph;
            chartBarRects = [];
            hideChartTooltip();
            const canvas = elements.monthlyChart;
            const context = canvas.getContext("2d");
            const dpr = window.devicePixelRatio || 1;
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;
            context.scale(dpr, dpr);

            const width = rect.width;
            const height = rect.height;
            context.clearRect(0, 0, width, height);

            const padding = { top: 18, right: 16, bottom: 36, left: 34 };
            const chartWidth = width - padding.left - padding.right;
            const chartHeight = height - padding.top - padding.bottom;
            const maxValue = Math.max(1, ...graph.flatMap((item) => [item.income, item.expense]));
            const barWidth = chartWidth / graph.length * 0.35;
            const groupWidth = chartWidth / graph.length;

            context.strokeStyle = "rgba(19, 34, 56, 0.1)";
            context.fillStyle = "#667085";
            context.font = "12px sans-serif";

            for (let step = 0; step <= 4; step += 1) {
                const y = padding.top + chartHeight - (chartHeight / 4) * step;
                context.beginPath(); context.moveTo(padding.left, y); context.lineTo(width - padding.right, y); context.stroke();
                context.fillText(Math.round((maxValue / 4) * step).toLocaleString("ja-JP"), 6, y + 4);
            }

            graph.forEach((item, index) => {
                const centerX = padding.left + groupWidth * index + groupWidth / 2;
                const incomeHeight = (item.income / maxValue) * chartHeight;
                const expenseHeight = (item.expense / maxValue) * chartHeight;
                const incomeX = centerX - barWidth - 3;
                const expenseX = centerX + 3;
                const incomeY = padding.top + chartHeight - incomeHeight;
                const expenseY = padding.top + chartHeight - expenseHeight;

                context.fillStyle = "#1d4ed8";
                context.fillRect(incomeX, incomeY, barWidth, incomeHeight);
                context.fillStyle = "#dc2626";
                context.fillRect(expenseX, expenseY, barWidth, expenseHeight);
                context.fillStyle = "#132238";
                context.fillText(String(index + 1), centerX - 4, height - 14);

                // ホバー/タップで金額を吹き出し表示するための当たり判定を記録
                chartBarRects.push({
                    x: incomeX, y: incomeY, width: barWidth, height: Math.max(incomeHeight, 4),
                    label: `${item.month}月の収入`, amount: item.income,
                });
                chartBarRects.push({
                    x: expenseX, y: expenseY, width: barWidth, height: Math.max(expenseHeight, 4),
                    label: `${item.month}月の支出`, amount: item.expense,
                });
            });

            elements.monthlyChartLabel.textContent = `青が収入、赤が支出です。対象年: ${graph[0]?.monthKey?.slice(0, 4) ?? initialData.year}`;
        }

        function findChartBarAt(x, y) {
            return chartBarRects.find((barRect) => x >= barRect.x && x <= barRect.x + barRect.width && y >= barRect.y && y <= barRect.y + barRect.height);
        }

        function showChartTooltip(barRect) {
            const tooltip = elements.chartTooltip;
            tooltip.textContent = `${barRect.label}: ${formatAmount(barRect.amount)}`;
            tooltip.style.left = `${barRect.x + barRect.width / 2}px`;
            tooltip.style.top = `${barRect.y}px`;
            tooltip.style.display = "block";
        }

        function hideChartTooltip() {
            if (elements.chartTooltip) {
                elements.chartTooltip.style.display = "none";
            }
        }

        function handleChartPointer(event) {
            const canvasRect = elements.monthlyChart.getBoundingClientRect();
            const x = event.clientX - canvasRect.left;
            const y = event.clientY - canvasRect.top;
            const barRect = findChartBarAt(x, y);
            // 別の棒を指したら古い吹き出しは自動的に消え、新しい方だけが表示される（要素は1つだけなので置き換わる）
            if (barRect) {
                showChartTooltip(barRect);
            } else {
                hideChartTooltip();
            }
        }

        elements.monthlyChart.addEventListener("mousemove", handleChartPointer);
        elements.monthlyChart.addEventListener("mouseleave", hideChartTooltip);
        elements.monthlyChart.addEventListener("click", handleChartPointer);

