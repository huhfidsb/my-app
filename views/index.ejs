            const month = elements.splitMonth.value || initialData.monthKey;
            const splitSessions = await api(`/api/split-sessions?month=${month}`);
            renderSplitSessions(splitSessions.items);
        }

        async function refreshSavings() {
            const month = elements.savingsMonth.value || initialData.monthKey;
            const savings = await api(`/api/analytics/savings?month=${month}`);
            renderSavings(savings);
        }

        async function refreshAll() {
            await Promise.all([
                refreshRecordList(),
                refreshAnalysis(),
                refreshSplitList(),
                refreshSavings(),
            ]);
        }

        wireMonthNav(elements.recordMonth, "recordPrevMonth", "recordNextMonth", refreshRecordList);
        wireMonthNav(elements.analysisMonth, "analysisPrevMonth", "analysisNextMonth", refreshAnalysis);
        wireMonthNav(elements.splitMonth, "splitPrevMonth", "splitNextMonth", refreshSplitList);
        wireMonthNav(elements.savingsMonth, "savingsPrevMonth", "savingsNextMonth", refreshSavings);

        document.getElementById("saveSavingsGoal").addEventListener("click", async () => {
            const raw = document.getElementById("savingsGoalInput").value;
            const savingsGoalAmount = raw === "" ? null : Math.max(0, Number.parseInt(raw, 10) || 0);
            await api("/api/settings", { method: "PUT", body: JSON.stringify({ savingsGoalAmount }) });
            const settingsGoalField = document.getElementById("settingsSavingsGoal");
            if (settingsGoalField) settingsGoalField.value = savingsGoalAmount ?? "";
            await refreshSavings();
        });

        elements.transactionForm.addEventListener("submit", async (event) => {
            event.preventDefault();
            const formData = new FormData(elements.transactionForm);
            const editingId = elements.transactionForm.dataset.editingId;
            if (editingId) {
                await api(`/api/transactions/${editingId}`, { method: "PUT", body: JSON.stringify(Object.fromEntries(formData.entries())) });
            } else {
                await api("/api/transactions", { method: "POST", body: JSON.stringify(Object.fromEntries(formData.entries())) });
            }
            resetTransactionForm();
            await refreshAll();
        });

        elements.splitForm.addEventListener("submit", async (event) => {
            event.preventDefault();

            const participants = getParticipantNames();
            if (participants.length === 0) {
                alert("参加者を1人以上入力してください。");
                return;
            }

            if (splitPayments.length === 0) {
                alert("支払い明細（誰がいくら払ったか）を1件以上追加してください。");
                return;
            }

            const editingId = elements.splitForm.dataset.editingId;
            const payload = {
                title: document.getElementById("splitTitle").value,
                participants,
                payments: splitPayments,
            };

            if (editingId) {
                await api(`/api/split-sessions/${editingId}`, { method: "PUT", body: JSON.stringify(payload) });
            } else {
                await api("/api/split-sessions", { method: "POST", body: JSON.stringify(payload) });
            }

            resetSplitForm();
            await refreshAll();
        });

        window.addEventListener("resize", () => { renderMonthlyChart(latestMonthlyGraph); });

        initializeSplitForm();
        renderCategoryManagerList();
        populateCategorySelect();
        renderTransactions(initialData.transactions);
        renderAnalysisSummary(initialData.monthSummary);
        renderMonthlyChart(initialData.yearlyGraph);
        renderSplitSessions(initialData.splitSessions);
        renderSavings(initialData.savings);

        // ---------------- 設定パネル（ハンバーガーメニュー） ----------------

        const settingsBackdrop = document.getElementById("settingsBackdrop");
        const settingsPanel = document.getElementById("settingsPanel");
        const analysisTabBtn = document.getElementById("analysisTabBtn");

        function openSettings() {
            settingsBackdrop.classList.add("open");
            settingsPanel.classList.add("open");
            refreshDeviceList();
            refreshPinStatus();
        }
        function closeSettings() {
            settingsBackdrop.classList.remove("open");
            settingsPanel.classList.remove("open");
        }

        document.getElementById("openSettingsBtn").addEventListener("click", openSettings);
        document.getElementById("settingsCloseBtn").addEventListener("click", closeSettings);
        settingsBackdrop.addEventListener("click", closeSettings);

        document.getElementById("logoutBtn").addEventListener("click", async () => {
            await api("/api/auth/logout", { method: "POST" }).catch(() => {});
            window.location.href = "/login";
        });

        document.getElementById("analyticsEnabledToggle").addEventListener("change", async (event) => {
            const enabled = event.target.checked;
            try {
                await api("/api/settings", { method: "PUT", body: JSON.stringify({ analyticsEnabled: enabled }) });
                analysisTabBtn.style.display = enabled ? "" : "none";
                if (!enabled && analysisTabBtn.classList.contains("active")) {
                    document.querySelector('.tab-btn[data-tab="tab-record"]').click();
                }
            } catch (error) {
                alert(error.message);
                event.target.checked = !enabled;
            }
        });

        document.getElementById("saveSettingsGoalBtn").addEventListener("click", async () => {
            const raw = document.getElementById("settingsSavingsGoal").value;
            const savingsGoalAmount = raw === "" ? null : Math.max(0, Number.parseInt(raw, 10) || 0);
            try {
                await api("/api/settings", { method: "PUT", body: JSON.stringify({ savingsGoalAmount }) });
                document.getElementById("savingsGoalInput").value = savingsGoalAmount ?? "";
                await refreshAll();
                alert("目標額を保存しました。");
            } catch (error) {
                alert(error.message);
            }
        });

        async function refreshPinStatus() {
            const view = document.getElementById("pinStatusView");
            view.innerHTML = initialData.user.pinEnabled
                ? '<p class="muted">現在PINログインは有効です。</p>'
                : '<p class="muted">現在PINログインは未設定です。</p>';
        }

        document.getElementById("setPinBtn").addEventListener("click", async () => {
            const pin = document.getElementById("settingsPinInput").value;
            if (!/^\d{4,8}$/.test(pin)) {
                alert("PINは4〜8桁の数字で入力してください。");
                return;
            }
            try {
                await api("/api/auth/pin", { method: "POST", body: JSON.stringify({ pin }) });
                initialData.user.pinEnabled = true;
                document.getElementById("settingsPinInput").value = "";
                refreshPinStatus();
                alert("PINを設定しました。");
            } catch (error) {
                alert(error.message);
            }
        });

        document.getElementById("removePinBtn").addEventListener("click", async () => {
            try {
                await api("/api/auth/pin", { method: "DELETE" });
                initialData.user.pinEnabled = false;
                refreshPinStatus();
            } catch (error) {
                alert(error.message);
            }
        });

        function bufferToBase64Url(buffer) {
            const bytes = new Uint8Array(buffer);
            let str = "";
            for (const b of bytes) str += String.fromCharCode(b);
            return btoa(str).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
        }
        function base64UrlToBuffer(value) {
            const padded = value.replace(/-/g, "+").replace(/_/g, "/") + "===".slice((value.length + 3) % 4);
            const str = atob(padded);
            const bytes = new Uint8Array(str.length);
            for (let i = 0; i < str.length; i += 1) bytes[i] = str.charCodeAt(i);
            return bytes;
        }

        async function refreshDeviceList() {
            const listEl = document.getElementById("webauthnDeviceList");
            try {
                const { items } = await api("/api/auth/webauthn/credentials");
                listEl.innerHTML = items.length
                    ? items.map((item) => `
                        <div class="device-item">
                            <span>${escapeHtml(item.label || "この端末")}</span>
                            <button type="button" class="remove-btn" data-device-id="${item.id}" title="削除">×</button>
                        </div>
                    `).join("")
                    : '<p class="muted">登録済みの端末はありません。</p>';

                listEl.querySelectorAll("[data-device-id]").forEach((button) => {
                    button.addEventListener("click", async () => {
                        if (!confirm("この端末の生体認証ログインを削除しますか？")) return;
                        await api(`/api/auth/webauthn/credentials/${button.dataset.deviceId}`, { method: "DELETE" });
                        localStorage.removeItem("mp_webauthn_credential_id");
                        refreshDeviceList();
                    });
                });
            } catch (error) {
                listEl.innerHTML = '<p class="muted">端末一覧を取得できませんでした。</p>';
            }
        }

        document.getElementById("registerBiometricBtn").addEventListener("click", async () => {
            if (!window.PublicKeyCredential) {
                alert("この端末・ブラウザはFace ID／指紋（WebAuthn）に対応していません。");
                return;
            }
            try {
                const { challenge } = await api("/api/auth/webauthn/challenge");
                const credential = await navigator.credentials.create({
                    publicKey: {
                        challenge: base64UrlToBuffer(challenge),
                        rp: { name: "MoneyPilot" },
                        user: {
                            id: base64UrlToBuffer(bufferToBase64Url(new TextEncoder().encode(String(initialData.user.username)))),
                            name: initialData.user.username,
                            displayName: initialData.user.username,
                        },
                        pubKeyCredParams: [{ alg: -7, type: "public-key" }, { alg: -257, type: "public-key" }],
                        authenticatorSelection: { authenticatorAttachment: "platform", userVerification: "required" },
                        timeout: 60000,
                    },
                });

                const credentialId = credential.id; // 既にbase64url文字列
                const label = navigator.userAgentData?.platform || navigator.platform || "この端末";
                await api("/api/auth/webauthn/register", { method: "POST", body: JSON.stringify({ credentialId, label }) });

                localStorage.setItem("mp_last_user", initialData.user.username);
                localStorage.setItem("mp_webauthn_credential_id", credentialId);

                alert("この端末でFace ID／指紋によるログインを設定しました。");
                refreshDeviceList();
            } catch (error) {
                alert("生体認証の登録に失敗しました：" + error.message);
            }
        });
    </script>
</body>
</html>
