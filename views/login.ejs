<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ログイン | MoneyPilot</title>
    <style>
      :root {
        color-scheme: light;
        --panel: rgba(255, 255, 255, 0.9);
        --text: #132238;
        --muted: #667085;
        --accent: #0f4c5c;
        --danger: #dc2626;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: "Hiragino Sans", "Yu Gothic", "Noto Sans JP", sans-serif;
        color: var(--text);
        background:
          radial-gradient(
            circle at top left,
            rgba(15, 76, 92, 0.18),
            transparent 30%
          ),
          radial-gradient(
            circle at top right,
            rgba(217, 119, 6, 0.14),
            transparent 26%
          ),
          linear-gradient(180deg, #fbf8f3 0%, #f4efe7 100%);
      }
      .card {
        width: min(420px, calc(100% - 32px));
        background: var(--panel);
        border: 1px solid rgba(255, 255, 255, 0.75);
        border-radius: 24px;
        box-shadow: 0 20px 60px rgba(19, 34, 56, 0.14);
        padding: 32px;
      }
      h1 {
        margin: 0 0 6px;
        font-size: 1.6rem;
      }
      p.hint {
        margin: 0 0 22px;
        color: var(--muted);
        font-size: 0.92rem;
        line-height: 1.6;
      }
      .tabs {
        display: flex;
        gap: 6px;
        margin-bottom: 20px;
        background: rgba(19, 34, 56, 0.06);
        border-radius: 999px;
        padding: 4px;
      }
      .tabs button {
        flex: 1;
        border: 0;
        background: transparent;
        padding: 10px;
        border-radius: 999px;
        font: inherit;
        font-weight: 700;
        color: var(--muted);
        cursor: pointer;
      }
      .tabs button.active {
        background: var(--accent);
        color: #fff;
      }
      .panel-block {
        display: none;
        flex-direction: column;
        gap: 12px;
      }
      .panel-block.active {
        display: flex;
      }
      .step {
        display: none;
        flex-direction: column;
        gap: 12px;
      }
      .step.active {
        display: flex;
      }
      .field {
        display: grid;
        gap: 6px;
      }
      .field label {
        font-size: 0.85rem;
        color: var(--muted);
      }
      .field input {
        border: 1px solid rgba(19, 34, 56, 0.16);
        border-radius: 12px;
        padding: 12px 14px;
        font: inherit;
        background: #fff;
        color: var(--text);
      }
      .field input[data-code] {
        letter-spacing: 0.4em;
        text-align: center;
        font-size: 1.4rem;
      }
      button.submit {
        border: 0;
        border-radius: 999px;
        padding: 13px 16px;
        background: var(--accent);
        color: #fff;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
        margin-top: 6px;
      }
      button.link-btn {
        border: 0;
        background: transparent;
        color: var(--accent);
        font: inherit;
        font-size: 0.85rem;
        text-decoration: underline;
        cursor: pointer;
        padding: 4px 0;
        align-self: flex-start;
      }
      .error {
        color: var(--danger);
        font-size: 0.88rem;
        min-height: 1.2em;
      }
      .notice {
        color: var(--muted);
        font-size: 0.85rem;
        line-height: 1.6;
      }
      .divider {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--muted);
        font-size: 0.8rem;
        margin: 18px 0;
      }
      .divider::before,
      .divider::after {
        content: "";
        flex: 1;
        height: 1px;
        background: rgba(19, 34, 56, 0.12);
      }
      .switch-user {
        text-align: center;
        margin-top: 10px;
        font-size: 0.85rem;
      }
      .switch-user a {
        color: var(--accent);
        cursor: pointer;
        text-decoration: underline;
      }
      .biometric-block {
        display: none;
        flex-direction: column;
        gap: 10px;
      }
      .biometric-block.visible {
        display: flex;
      }
      .forgot-link {
        text-align: right;
        margin-top: -4px;
      }
      .forgot-link a {
        color: var(--accent);
        font-size: 0.82rem;
        cursor: pointer;
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>MoneyPilot</h1>
      <p class="hint">
        家計簿はユーザーごとに保存されます。ログインして続けましょう。
      </p>

      <div class="biometric-block" id="biometricBlock">
        <button type="button" class="submit" id="biometricLoginBtn">
          🔓 Face ID / 指紋でログイン（<span id="biometricUserLabel"></span>）
        </button>
        <div class="switch-user">
          <a id="switchAwayFromBiometric">別のログイン方法を使う</a>
        </div>
        <div class="divider">または</div>
      </div>

      <div id="mainAuthBlock">
        <div class="tabs">
          <button
            type="button"
            class="tab-toggle active"
            data-target="loginPanel"
          >
            ログイン
          </button>
          <button type="button" class="tab-toggle" data-target="registerPanel">
            新規登録
          </button>
        </div>

        <div class="error" id="authError"></div>

        <!-- ログイン -->
        <div id="loginPanel" class="panel-block active">
          <form id="loginForm">
            <div class="field">
              <label for="loginEmail">メールアドレス</label>
              <input
                id="loginEmail"
                name="email"
                type="email"
                autocomplete="email"
                required
              />
            </div>
            <div class="field">
              <label for="loginPassword">パスワード</label>
              <input
                id="loginPassword"
                name="password"
                type="password"
                autocomplete="current-password"
                required
              />
            </div>
            <div class="forgot-link">
              <a id="openForgotPassword">パスワードをお忘れですか？</a>
            </div>
            <button type="submit" class="submit">ログイン</button>
          </form>
        </div>

        <!-- 新規登録：メールアドレス + パスワード -->
        <div id="registerPanel" class="panel-block">
          <form id="registerForm">
            <div class="field">
              <label for="registerEmail">メールアドレス</label>
              <input
                id="registerEmail"
                type="email"
                autocomplete="email"
                required
              />
            </div>
            <div class="field">
              <label for="registerPassword">パスワード（8文字以上）</label>
              <input
                id="registerPassword"
                type="password"
                autocomplete="new-password"
                required
              />
            </div>
            <button type="submit" class="submit" id="registerSubmitBtn">
              登録して始める
            </button>
          </form>
        </div>

        <!-- パスワードを忘れた場合：メール認証 → 新しいパスワード -->
        <div id="forgotPanel" class="panel-block">
          <div class="step active" id="forgotStepEmail">
            <p class="notice">
              登録済みのメールアドレスに、パスワード再設定用の6桁コードを送ります。
            </p>
            <div class="field">
              <label for="forgotEmail">登録済みメールアドレス</label>
              <input
                id="forgotEmail"
                type="email"
                autocomplete="email"
                required
              />
            </div>
            <button type="button" class="submit" id="sendForgotCodeBtn">
              認証コードを送信
            </button>
            <button type="button" class="link-btn" id="backToLoginFromForgot">
              ログインに戻る
            </button>
          </div>

          <div class="step" id="forgotStepCode">
            <p class="notice">
              <span id="forgotCodeSentTo"></span>
              に送信したコードを入力してください。
            </p>
            <div class="field">
              <label for="forgotCode">認証コード（6桁）</label>
              <input
                id="forgotCode"
                inputmode="numeric"
                pattern="\d*"
                maxlength="6"
                data-code
                required
              />
            </div>
            <button type="button" class="submit" id="verifyForgotCodeBtn">
              確認する
            </button>
            <button type="button" class="link-btn" id="resendForgotCodeBtn">
              コードを再送する
            </button>
          </div>

          <div class="step" id="forgotStepNewPassword">
            <p class="notice" id="forgotUsernameHint"></p>
            <div class="field">
              <label for="forgotNewPassword"
                >新しいパスワード（8文字以上）</label
              >
              <input
                id="forgotNewPassword"
                type="password"
                autocomplete="new-password"
                required
              />
            </div>
            <button type="button" class="submit" id="completeForgotBtn">
              パスワードを再設定してログイン
            </button>
          </div>
        </div>
      </div>
    </div>

    <script>
      const authError = document.getElementById("authError");
      const tabButtons = document.querySelectorAll(".tab-toggle");
      const panelBlocks = document.querySelectorAll(".panel-block");
      const mainAuthBlock = document.getElementById("mainAuthBlock");
      const biometricBlock = document.getElementById("biometricBlock");

      function showPanel(id) {
        panelBlocks.forEach((panel) => panel.classList.remove("active"));
        document.getElementById(id).classList.add("active");
        authError.textContent = "";
      }

      function showStep(containerId, stepId) {
        document
          .querySelectorAll(`#${containerId} .step`)
          .forEach((step) => step.classList.remove("active"));
        document.getElementById(stepId).classList.add("active");
        authError.textContent = "";
      }

      tabButtons.forEach((button) => {
        button.addEventListener("click", () => {
          tabButtons.forEach((b) => b.classList.remove("active"));
          button.classList.add("active");
          showPanel(button.dataset.target);
        });
      });

      function showError(message) {
        authError.textContent = message;
      }

      function bufferToBase64Url(buffer) {
        const bytes = new Uint8Array(buffer);
        let str = "";
        for (const b of bytes) str += String.fromCharCode(b);
        return btoa(str)
          .replace(/\+/g, "-")
          .replace(/\//g, "_")
          .replace(/=+$/, "");
      }

      function base64UrlToBuffer(value) {
        const padded =
          value.replace(/-/g, "+").replace(/_/g, "/") +
          "===".slice((value.length + 3) % 4);
        const str = atob(padded);
        const bytes = new Uint8Array(str.length);
        for (let i = 0; i < str.length; i += 1) bytes[i] = str.charCodeAt(i);
        return bytes;
      }

      async function submitJson(url, body) {
        const response = await fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify(body ?? {}),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok)
          throw new Error(data.message || "エラーが発生しました。");
        return data;
      }

      // ---------- ログイン ----------

      document
        .getElementById("loginForm")
        .addEventListener("submit", async (event) => {
          event.preventDefault();
          showError("");
          const email = document.getElementById("loginEmail").value.trim();
          const password = document.getElementById("loginPassword").value;
          try {
            const data = await submitJson("/api/auth/login", {
              email,
              password,
            });
            localStorage.setItem("mp_last_email", email);
            if (data.user?.username)
              localStorage.setItem("mp_last_user", data.user.username);
            window.location.href = "/";
          } catch (error) {
            showError(error.message);
          }
        });

      // ---------- 新規登録（メールアドレス + パスワード） ----------

      document
        .getElementById("registerForm")
        .addEventListener("submit", async (event) => {
          event.preventDefault();
          showError("");
          const email = document.getElementById("registerEmail").value.trim();
          const password = document.getElementById("registerPassword").value;
          try {
            const data = await submitJson("/api/auth/register", {
              email,
              password,
            });
            localStorage.setItem("mp_last_email", email);
            if (data.user?.username) {
              localStorage.setItem("mp_last_user", data.user.username);
            }
            window.location.href = "/";
          } catch (error) {
            showError(error.message);
          }
        });

      // ---------- パスワードを忘れた場合 ----------

      let pendingForgotEmail = "";
      let forgotVerifyToken = "";

      document
        .getElementById("openForgotPassword")
        .addEventListener("click", () => {
          tabButtons.forEach((b) => b.classList.remove("active"));
          showPanel("forgotPanel");
          showStep("forgotPanel", "forgotStepEmail");
        });

      document
        .getElementById("backToLoginFromForgot")
        .addEventListener("click", () => {
          document
            .querySelector('.tab-toggle[data-target="loginPanel"]')
            .click();
        });

      document
        .getElementById("sendForgotCodeBtn")
        .addEventListener("click", async () => {
          showError("");
          const email = document.getElementById("forgotEmail").value.trim();
          if (!email) {
            showError("メールアドレスを入力してください。");
            return;
          }
          try {
            await submitJson("/api/auth/password-reset/request", { email });
            pendingForgotEmail = email;
            document.getElementById("forgotCodeSentTo").textContent = email;
            showStep("forgotPanel", "forgotStepCode");
          } catch (error) {
            showError(error.message);
          }
        });

      document
        .getElementById("resendForgotCodeBtn")
        .addEventListener("click", async () => {
          showError("");
          try {
            await submitJson("/api/auth/password-reset/request", {
              email: pendingForgotEmail,
            });
            showError("コードを再送しました。");
          } catch (error) {
            showError(error.message);
          }
        });

      document
        .getElementById("verifyForgotCodeBtn")
        .addEventListener("click", async () => {
          showError("");
          const code = document.getElementById("forgotCode").value.trim();
          try {
            const data = await submitJson("/api/auth/password-reset/verify", {
              email: pendingForgotEmail,
              code,
            });
            forgotVerifyToken = data.verifyToken;
            document.getElementById("forgotUsernameHint").textContent =
              data.username
                ? `ユーザー名は「${data.username}」です。新しいパスワードを設定してください。`
                : "新しいパスワードを設定してください。";
            showStep("forgotPanel", "forgotStepNewPassword");
          } catch (error) {
            showError(error.message);
          }
        });

      document
        .getElementById("completeForgotBtn")
        .addEventListener("click", async () => {
          showError("");
          const newPassword =
            document.getElementById("forgotNewPassword").value;
          try {
            await submitJson("/api/auth/password-reset/complete", {
              verifyToken: forgotVerifyToken,
              newPassword,
            });
            window.location.href = "/";
          } catch (error) {
            showError(error.message);
          }
        });

      // ---------- Face ID / 指紋での再ログイン（この端末で以前登録した場合のみ表示） ----------
      (function setupBiometric() {
        const savedUser = localStorage.getItem("mp_last_user");
        const savedCredentialId = localStorage.getItem(
          "mp_webauthn_credential_id",
        );
        if (!savedUser || !savedCredentialId || !window.PublicKeyCredential)
          return;

        document.getElementById("biometricUserLabel").textContent = savedUser;
        biometricBlock.classList.add("visible");
        mainAuthBlock.style.display = "none";

        document
          .getElementById("switchAwayFromBiometric")
          .addEventListener("click", () => {
            biometricBlock.classList.remove("visible");
            mainAuthBlock.style.display = "block";
            const savedEmail = localStorage.getItem("mp_last_email");
            if (savedEmail)
              document.getElementById("loginEmail").value = savedEmail;
          });

        document
          .getElementById("biometricLoginBtn")
          .addEventListener("click", async () => {
            showError("");
            try {
              const { challenge } = await fetch(
                "/api/auth/webauthn/challenge",
              ).then((r) => r.json());
              await navigator.credentials.get({
                publicKey: {
                  challenge: base64UrlToBuffer(challenge),
                  allowCredentials: [
                    {
                      id: base64UrlToBuffer(savedCredentialId),
                      type: "public-key",
                    },
                  ],
                  userVerification: "required",
                  timeout: 60000,
                },
              });
              // ブラウザの生体認証プロンプトを通過したら、端末側のログイン用cookieでログインする
              const response = await fetch("/api/auth/webauthn/login", {
                method: "POST",
                credentials: "include",
              });
              const data = await response.json().catch(() => ({}));
              if (!response.ok)
                throw new Error(
                  data.message || "生体認証ログインに失敗しました。",
                );
              window.location.href = "/";
            } catch (error) {
              showError(
                "生体認証でのログインに失敗しました。パスワードでログインしてください。",
              );
              biometricBlock.classList.remove("visible");
              mainAuthBlock.style.display = "block";
            }
          });
      })();
    </script>
  </body>
</html>
